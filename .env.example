# ---- Online Kass: copy to .env and fill in. Never commit the real file. ----
NODE_ENV=production

# Public addresses (any domain works, nothing is hardcoded)
WEB_ORIGIN=https://kass.example.com
PUBLIC_API_URL=https://kass.example.com

# Database: MongoDB MUST run as a replica set (transactions are used for stock and sales)
MONGO_URI=mongodb://mongo:27017/onlinekass?replicaSet=rs0

# Secrets. Generate with:  openssl rand -hex 32   (ENCRYPTION_KEY must be exactly 64 hex chars)
JWT_ACCESS_SECRET=change-me-at-least-32-random-characters
JWT_REFRESH_SECRET=change-me-another-32-random-characters
ENCRYPTION_KEY=

ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
BCRYPT_COST=12
# Set to false only when serving over plain HTTP (not recommended outside a LAN test)
COOKIE_SECURE=true

# First platform owner (used by `npm run seed:superadmin`)
SUPERADMIN_LOGIN=admin
SUPERADMIN_PASSWORD=
SUPERADMIN_FULL_NAME=Platform Owner

# Telegram (optional): bot for shop notifications and platform alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
SUPERADMIN_TELEGRAM_CHAT_ID=

# Files: local disk by default; S3-compatible storage when all four are set
UPLOAD_DIR=/data/uploads
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Background jobs run inside the API process; set false on all but one replica
RUN_WORKERS=true
SENTRY_DSN=
