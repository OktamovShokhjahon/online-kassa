{
  "name": "@kass/agent",
  "version": "1.0.0",
  "private": true,
  "description": "Online Kass local agent: thermal printer (ESC/POS), cash drawer and scanner bridge for the cash desk PC",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsup",
    "build:exe": "npm run build && pkg dist/index.js --targets node20-win-x64 --output release/OnlineKassAgent.exe",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@kass/shared": "*",
    "iconv-lite": "^0.6.3",
    "ws": "^8.18.0"
  },
  "optionalDependencies": {
    "serialport": "^12.0.0",
    "systray2": "^2.1.4"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/ws": "^8.5.13",
    "@yao-pkg/pkg": "^6.1.1",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "vitest": "^2.1.5"
  },
  "pkg": {
    "assets": ["ui/**/*"],
    "scripts": ["dist/**/*.js"]
  }
}
